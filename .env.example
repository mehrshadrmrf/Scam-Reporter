# ---------- App ----------
APP_NAME=ScamReport
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string

# ---------- Database ----------
POSTGRES_USER=scamreport
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scamreport
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://scamreport:change-me@db:5432/scamreport

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---------- Object Storage (MinIO/S3) ----------
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
S3_BUCKET=scamreport-evidence
S3_SECURE=false

# ---------- Telegram Bot ----------
BOT_TOKEN=123456:your-telegram-bot-token
ADMIN_TELEGRAM_IDS=111111111,222222222

# ---------- Security ----------
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------- Trust Score ----------
TRUST_SCORE_VALID_REPORT=10
TRUST_SCORE_INCOMPLETE_REPORT=-5
TRUST_SCORE_FALSE_REPORT=-20
TRUST_SCORE_ABUSE_ATTEMPT=-100
TRUST_SCORE_BAN_THRESHOLD=-100
TRUST_SCORE_RESTRICT_THRESHOLD=-50

# ---------- Publishing rules ----------
MIN_INDEPENDENT_REPORTERS_TO_PUBLISH=2
